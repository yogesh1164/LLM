# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
AI_PROVIDER=gemini
# Required bearer token for API routes. Generate with:
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
API_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Search grounding can incur billing; opt in only after checking project tier/quotas.
GEMINI_SEARCH_GROUNDING_ENABLED=false
# Optional fallback provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# FRONTEND_ORIGIN remains supported as a legacy single-origin override.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://agentflow:agentflow@localhost:5432/agentflow
# Set to a positive number to remove tasks older than that many days when a new workflow starts.
TASK_RETENTION_DAYS=0
OPENAI_WEB_SEARCH_ENABLED=true
WORKFLOW_TIMEOUT_SECONDS=600
AGENT_TIMEOUT_SECONDS=90
PROVIDER_RETRY_ATTEMPTS=0
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.5
PROVIDER_RETRY_MAX_DELAY_SECONDS=4
# Set per-stage values to override AGENT_TIMEOUT_SECONDS (seconds).
# ORCHESTRATOR_TIMEOUT_SECONDS=60
RESEARCH_TIMEOUT_SECONDS=90
# ANALYSIS_TIMEOUT_SECONDS=90
# REPORT_TIMEOUT_SECONDS=90
REVIEW_TIMEOUT_SECONDS=180
MAX_STAGE_OUTPUT_CHARS=12000
MAX_STAGE_INPUT_CHARS=40000
MAX_MODEL_CALLS_PER_WORKFLOW=5
RATE_LIMIT_PER_MINUTE=10
INPUT_TOKEN_COST_PER_MILLION=0.25
CACHED_INPUT_TOKEN_COST_PER_MILLION=0.025
OUTPUT_TOKEN_COST_PER_MILLION=2.0

