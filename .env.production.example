# Copy ONCE to .env.production; never overwrite .env or an existing production file.
# Generate separate 32-byte random hexadecimal strings for each secret.
POSTGRES_PASSWORD=
API_ACCESS_TOKEN=
GEMINI_API_KEY=
APP_ENV=production
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SEARCH_GROUNDING_ENABLED=false
SITE_HOST=localhost
FRONTEND_ORIGINS=https://localhost:8443
PROVIDER_RETRY_ATTEMPTS=0
# Per-process bound; cancelled callers retain their slot until SDK work exits.
PROVIDER_MAX_CONCURRENCY=4
RESEARCH_TIMEOUT_SECONDS=90
REVIEW_TIMEOUT_SECONDS=180
WORKFLOW_TIMEOUT_SECONDS=600
RATE_LIMIT_PER_MINUTE=10
# API bodies are bounded before JSON parsing and endpoint side effects (256 KiB).
MAX_REQUEST_BODY_BYTES=262144
# Keep disabled until the additive migration and caller idempotency contract
# have been reviewed and rehearsed on an isolated database. Never auto-migrate.
DURABLE_EXECUTION_ENABLED=false
EXECUTION_LEASE_SECONDS=60
EXECUTION_HEARTBEAT_SECONDS=5
EXECUTION_RECOVERY_SECONDS=15
TASK_RETENTION_DAYS=0
